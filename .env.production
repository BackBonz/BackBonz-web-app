# Production build env for GitHub Pages (loaded automatically by `vite build`).
#
# These VITE_* values are CLIENT-SIDE PUBLIC by design — Vite inlines them into
# the JS bundle on any host, and Firebase security is enforced by Auth +
# Firestore/Storage rules, not by hiding the web API key. Committing them here is
# what lets the GitHub Actions build run with no repository secrets.
#
# Do NOT put server-only secrets here (RESEND_API_KEY, RECAPTCHA_SECRET_KEY):
# Vite only exposes VITE_-prefixed vars, and GitHub Pages can't run the
# api/contact.js serverless function anyway (the contact form writes to Firestore).

# ── Firebase ──────────────────────────────────────────────────────────
VITE_FIREBASE_API_KEY=AIzaSyAj4EkxmpS3Ac1yGKlirWyxW-pC4X8imXc
VITE_FIREBASE_AUTH_DOMAIN=backbonz-f5214.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=backbonz-f5214
VITE_FIREBASE_STORAGE_BUCKET=backbonz-f5214.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=284935458461
VITE_FIREBASE_APP_ID=1:284935458461:web:08f61d56c4eb392b774e74
VITE_FIREBASE_MEASUREMENT_ID=G-CX02GHL2PX

# ── Google reCAPTCHA v3 (public site key; leave blank to skip client checks) ──
VITE_RECAPTCHA_SITE_KEY=

# ── Admin ──────────────────────────────────────────────────────────────
VITE_ADMIN_EMAIL=admin.backbonz@gmail.com
